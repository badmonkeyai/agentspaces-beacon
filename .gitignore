# AgentSpaces Beacon repository.
#
# What must be COMMITTED and therefore is deliberately NOT listed here:
#   .github/          the CI workflows and Dependabot config

# Maven build output, in every module
target/
dependency-reduced-pom.xml
release.properties
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
.flattened-pom.xml
.mvn/wrapper/maven-wrapper.jar

# Compiled classes outside target (IDE builds)
*.class
hs_err_pid*
replay_pid*

# IDEs and editors
.vscode/
.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
.factorypath
.apt_generated/
.sts4-cache/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Logs and scratch
*.log
/tmp/

# Peer key material a running node persists (FileKeystore); never commit a private key
# or a model provider's API key. The README's example keystore path is ./beacon-keys.
peer.key
peer.keys/
beacon-keys/
*.pem
*.p12
*.jks

# Local environment
.env
.env.local
